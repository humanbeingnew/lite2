{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lite-paragraph-summarizer",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  }
}
